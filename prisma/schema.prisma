generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  chatId    String?
  phone     String?
  authorId  String?
  targetId  String?
  messageId String?
  content   String?  @db.Text
  details   String?  @db.LongText
  createdAt DateTime @default(now())

  @@map("logs")
}

model OraclePrediction {
  id        Int      @id @default(autoincrement())
  phone     String
  weekKey   String
  message   String   @db.Text
  luckType  String   @default("SORTE")
  luckyNumber Int    @default(0)
  animalName String?
  createdAt DateTime @default(now())

  @@unique([phone, weekKey])
  @@map("oracle_predictions")
}

model PowerAnimal {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  habitat     String?
  createdAt   DateTime @default(now())

  @@map("power_animals")
}

model MediaHash {
  id        Int      @id @default(autoincrement())
  md5       String   @unique
  isNsfw    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("media_hashes")
}

model MessageStats {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId])
  @@map("message_stats")
}

model MessageStatsBucket {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  periodType    String   @db.VarChar(16)
  periodStart   DateTime
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId, periodType, periodStart])
  @@map("message_stats_buckets")
}

model PhilosopherProtector {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  phrase      String   @db.Text
  createdAt   DateTime @default(now())

  @@map("philosopher_protectors")
}

model Joke {
  id    Int    @id @default(autoincrement())
  text  String @db.Text

  @@map("jokes")
}

model Admin {
  phone          String  @id @db.VarChar(32)
  authorId       String  @db.VarChar(64)
  password       String  @db.VarChar(255)
  expirePassword Boolean @default(true) @map("expire_password")

  @@map("admins")
}

model WelcomeConfig {
  id              Int      @id @default(autoincrement())
  chatId           String   @unique
  message          String   @db.Text
  peopleToTrigger  Int      @default(1)
  counter          Int      @default(0)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("welcome_configs")
}
