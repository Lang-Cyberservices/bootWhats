generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  chatId    String?
  phone     String?
  authorId  String?
  targetId  String?
  messageId String?
  content   String?  @db.Text
  details   String?  @db.LongText
  createdAt DateTime @default(now())

  @@map("logs")
}

model CommandLog {
  id        Int      @id @default(autoincrement())
  command   String
  args      String?  @db.Text
  chatId    String?
  chatName  String?
  authorId  String?
  phone     String?
  messageId String?
  createdAt DateTime @default(now())

  @@map("command_logs")
}

model OraclePrediction {
  id          Int      @id @default(autoincrement())
  phone       String
  weekKey     String
  message     String   @db.Text
  luckType    String   @default("SORTE")
  theme       String?  @db.VarChar(191)
  luckyNumber Int      @default(0)
  animalName  String?
  createdAt   DateTime @default(now())

  @@unique([phone, weekKey])
  @@map("oracle_predictions")
}

model PowerAnimal {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  habitat     String?
  createdAt   DateTime @default(now())

  @@map("power_animals")
}

model MediaHash {
  id        Int      @id @default(autoincrement())
  md5       String   @unique
  // SHA256 do arquivo original, vindo do protocolo do WhatsApp (msg.rawData.filehash).
  // É estável entre remetentes, então permite reconhecer uma imagem já julgada
  // ANTES de baixá-la. Nulo para hashes gravados antes desta coluna existir.
  fileHash  String?  @unique @db.VarChar(128)
  isNsfw    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("media_hashes")
}

model MessageStats {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId])
  @@map("message_stats")
}

model MessageStatsBucket {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  periodType    String   @db.VarChar(16)
  periodStart   DateTime
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId, periodType, periodStart])
  @@map("message_stats_buckets")
}

model OracleTheme {
  id        Int      @id @default(autoincrement())
  theme     String
  createdAt DateTime @default(now())

  @@map("oracle_themes")
}

model PhilosopherProtector {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  phrase      String   @db.Text
  createdAt   DateTime @default(now())

  @@map("philosopher_protectors")
}

model Joke {
  id   Int    @id @default(autoincrement())
  text String @db.Text

  @@map("jokes")
}

model Admin {
  phone          String  @id @db.VarChar(32)
  authorId       String  @db.VarChar(64)
  password       String  @db.VarChar(255)
  expirePassword Boolean @default(true) @map("expire_password")

  @@map("admins")
}

model WelcomeConfig {
  id              Int      @id @default(autoincrement())
  chatId          String   @unique
  message         String   @db.Text
  peopleToTrigger Int      @default(1)
  counter         Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("welcome_configs")
}

model CommandBlocked {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(64)
  chatId         String   @db.VarChar(191)
  blockedBy      String?  @db.VarChar(191)
  blockedByPhone String?  @db.VarChar(32)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chatId, name])
  @@map("commands_blocked")
}

model BookTopWeek {
  id        Int      @id @default(autoincrement())
  week      DateTime @db.Date
  book      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([week, book])
  @@map("books_top_week")
}

model BooksDownload {
  id        Int      @id @default(autoincrement())
  font      String   @db.VarChar(255)
  link      String   @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books_download")
}

model BookRecomendation {
  id          Int      @id @default(autoincrement())
  book        String   @db.VarChar(255)
  autoctor    String   @db.VarChar(255)
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("book_recomendation")
}

model UserHoroscope {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @db.VarChar(191)
  phone     String?  @db.VarChar(191)
  sign      String   @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_horoscopes")
}

model DailyHoroscope {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  sign      String   @db.VarChar(64)
  horoscope String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, sign])
  @@map("daily_horoscopes")
}

model Dictionary {
  id               Int      @id @default(autoincrement())
  word             String   @unique @db.VarChar(255)
  charactersCount  Int
  nounMeaning      String?  @db.Text
  verbMeaning      String?  @db.Text
  adjectiveMeaning String?  @db.Text
  adverbMeaning    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("dictionary")
}

model Movie {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(255)
  themoviedbId Int?     @map("themoviedb_id")
  createdAt    DateTime @default(now())

  @@map("movies")
}

model GameForca {
  id                    Int       @id @default(autoincrement())
  chatId                String    @db.VarChar(255)
  mode                  String    @db.VarChar(50)
  status                String    @db.VarChar(20)
  answer                String    @db.VarChar(255)
  answerRef             String?   @db.VarChar(255)
  guessedLetters        String    @db.Text
  wrongLetters          String    @db.Text
  wrongGuesses          String    @db.Text
  errorsCount           Int       @default(0)
  lastLetterAuthorId    String?   @db.VarChar(255)
  lastLetterAt          DateTime?
  currentRoundMessageId String?   @db.VarChar(255)
  roundMessageIds       String    @db.Text
  startedBy             String    @db.VarChar(255)
  winnerId              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  finishedAt            DateTime?

  participants GameForcaParticipant[]

  @@map("game_forca")
}

model GameForcaParticipant {
  id           Int      @id @default(autoincrement())
  gameId       Int
  authorId     String   @db.VarChar(255)
  pointsEarned Int      @default(0)
  eliminated   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game GameForca @relation(fields: [gameId], references: [id])

  @@unique([gameId, authorId])
  @@map("game_forca_participants")
}

model Country {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  sigla       String   @unique @db.VarChar(255)
  description String?  @db.Text
  flag        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countries")
}

model GameXadrez {
  id                    Int       @id @default(autoincrement())
  chatId                String    @db.VarChar(255)
  status                String    @db.VarChar(20)
  player1Id             String    @db.VarChar(255)
  player2Id             String?   @db.VarChar(255)
  whiteId               String?   @db.VarChar(255)
  blackId               String?   @db.VarChar(255)
  fen                   String    @db.Text
  movesSan              String    @db.Text
  lastMoveFrom          String?   @db.VarChar(4)
  lastMoveTo            String?   @db.VarChar(4)
  drawOfferBy           String?   @db.VarChar(255)
  currentRoundMessageId String?   @db.VarChar(255)
  roundMessageIds       String    @db.Text
  startedBy             String    @db.VarChar(255)
  result                String?   @db.VarChar(20)
  winnerId              String?   @db.VarChar(255)
  endReason             String?   @db.VarChar(40)
  lastMoveAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  finishedAt            DateTime?

  @@index([chatId, status])
  @@map("game_xadrez")
}

// Wordle multiplayer. `answer` guarda a grafia do banco (com acento) só para a
// revelação no fim; toda a comparação roda sobre `answerLetters`, normalizado e
// sem espaços. Os palpites vivem num JSON porque nada consulta um palpite
// isolado — eles são lidos em bloco para redesenhar o tabuleiro e pontuar.
model GameLetreco {
  id                    Int       @id @default(autoincrement())
  chatId                String    @db.VarChar(255)
  category              String    @db.VarChar(20)
  status                String    @db.VarChar(20)
  answer                String    @db.VarChar(255)
  answerLetters         String    @db.VarChar(255)
  answerRef             String?   @db.VarChar(255)
  wordLengths           String    @db.Text
  guesses               String    @db.Text
  attempts              Int       @default(0)
  lastPlayerId          String?   @db.VarChar(255)
  lastPlayedAt          DateTime?
  currentRoundMessageId String?   @db.VarChar(255)
  roundMessageIds       String    @db.Text
  startedBy             String    @db.VarChar(255)
  winnerId              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  finishedAt            DateTime?

  @@index([chatId, status])
  @@map("game_letreco")
}

model GameScore {
  id            Int      @id @default(autoincrement())
  chatId        String   @db.VarChar(255)
  authorId      String   @db.VarChar(255)
  gameType      String   @db.VarChar(50)
  totalPoints   Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  matchesPlayed Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId, gameType])
  @@map("game_scores")
}

// Fila de análise de imagens. O bot só baixa, hasheia e enfileira; o processo
// `bootwhats-analyzer` consome uma linha por vez e grava o veredito aqui.
// A chave é messageId (e não md5) porque cada mensagem precisa ser apagada
// individualmente — a deduplicação por md5 acontece na inferência, via MediaHash.
model MediaAnalysisJob {
  id           Int       @id @default(autoincrement())
  messageId    String    @unique @db.VarChar(191)
  md5          String    @db.VarChar(32)
  fileHash     String?   @db.VarChar(128)
  status       String    @default("pending") @db.VarChar(16)
  filePath     String    @db.VarChar(500)
  mimetype     String?   @db.VarChar(100)
  chatId       String    @db.VarChar(191)
  authorId     String?   @db.VarChar(191)
  phone        String?   @db.VarChar(32)
  caption      String?   @db.Text
  isNsfw       Boolean?
  predictions  String?   @db.LongText
  evidencePath String?   @db.VarChar(500)
  error        String?   @db.Text
  attempts     Int       @default(0)
  lockedAt     DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([md5])
  @@index([fileHash, status])
  @@map("media_analysis_jobs")
}

model VersionAnnouncement {
  id        Int       @id @default(autoincrement())
  version   String    @unique @db.VarChar(32)
  notes     String    @db.Text
  sent      Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("version_announcements")
}

model ErrorLog {
  id         Int       @id @default(autoincrement())
  process    String    @db.VarChar(32)
  context    String    @db.VarChar(191)
  message    String    @db.Text
  stack      String?   @db.LongText
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved, createdAt])
  @@map("error_logs")
}
