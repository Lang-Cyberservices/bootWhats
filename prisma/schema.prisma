generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  chatId    String?
  phone     String?
  authorId  String?
  targetId  String?
  messageId String?
  content   String?  @db.Text
  details   String?  @db.LongText
  createdAt DateTime @default(now())

  @@map("logs")
}

model CommandLog {
  id        Int      @id @default(autoincrement())
  command   String
  args      String?  @db.Text
  chatId    String?
  chatName  String?
  authorId  String?
  phone     String?
  messageId String?
  createdAt DateTime @default(now())

  @@map("command_logs")
}

model OraclePrediction {
  id          Int      @id @default(autoincrement())
  phone       String
  weekKey     String
  message     String   @db.Text
  luckType    String   @default("SORTE")
  theme       String?  @db.VarChar(191)
  luckyNumber Int      @default(0)
  animalName  String?
  createdAt   DateTime @default(now())

  @@unique([phone, weekKey])
  @@map("oracle_predictions")
}

model PowerAnimal {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  habitat     String?
  createdAt   DateTime @default(now())

  @@map("power_animals")
}

model MediaHash {
  id        Int      @id @default(autoincrement())
  md5       String   @unique
  isNsfw    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("media_hashes")
}

model MessageStats {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId])
  @@map("message_stats")
}

model MessageStatsBucket {
  id            Int      @id @default(autoincrement())
  chatId        String
  authorId      String
  phone         String?
  periodType    String   @db.VarChar(16)
  periodStart   DateTime
  messagesCount Int      @default(0)
  commandsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId, periodType, periodStart])
  @@map("message_stats_buckets")
}

model OracleTheme {
  id        Int      @id @default(autoincrement())
  theme     String
  createdAt DateTime @default(now())

  @@map("oracle_themes")
}

model PhilosopherProtector {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  phrase      String   @db.Text
  createdAt   DateTime @default(now())

  @@map("philosopher_protectors")
}

model Joke {
  id   Int    @id @default(autoincrement())
  text String @db.Text

  @@map("jokes")
}

model Admin {
  phone          String  @id @db.VarChar(32)
  authorId       String  @db.VarChar(64)
  password       String  @db.VarChar(255)
  expirePassword Boolean @default(true) @map("expire_password")

  @@map("admins")
}

model WelcomeConfig {
  id              Int      @id @default(autoincrement())
  chatId          String   @unique
  message         String   @db.Text
  peopleToTrigger Int      @default(1)
  counter         Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("welcome_configs")
}

model BookTopWeek {
  id        Int      @id @default(autoincrement())
  week      DateTime @db.Date
  book      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([week, book])
  @@map("books_top_week")
}

model BooksDownload {
  id        Int      @id @default(autoincrement())
  font      String   @db.VarChar(255)
  link      String   @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books_download")
}

model BookRecomendation {
  id          Int      @id @default(autoincrement())
  book        String   @db.VarChar(255)
  autoctor    String   @db.VarChar(255)
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("book_recomendation")
}

model UserHoroscope {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @db.VarChar(191)
  phone     String?  @db.VarChar(191)
  sign      String   @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_horoscopes")
}

model DailyHoroscope {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  sign      String   @db.VarChar(64)
  horoscope String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, sign])
  @@map("daily_horoscopes")
}

model Dictionary {
  id               Int      @id @default(autoincrement())
  word             String   @unique @db.VarChar(255)
  charactersCount  Int
  nounMeaning      String?  @db.Text
  verbMeaning      String?  @db.Text
  adjectiveMeaning String?  @db.Text
  adverbMeaning    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("dictionary")
}

model Movie {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(255)
  themoviedbId Int?     @map("themoviedb_id")
  createdAt    DateTime @default(now())

  @@map("movies")
}

model GameForca {
  id                    Int       @id @default(autoincrement())
  chatId                String    @db.VarChar(255)
  mode                  String    @db.VarChar(50)
  status                String    @db.VarChar(20)
  answer                String    @db.VarChar(255)
  answerRef             String?   @db.VarChar(255)
  guessedLetters        String    @db.Text
  wrongLetters          String    @db.Text
  wrongGuesses          String    @db.Text
  errorsCount           Int       @default(0)
  lastLetterAuthorId    String?   @db.VarChar(255)
  currentRoundMessageId String?   @db.VarChar(255)
  roundMessageIds       String    @db.Text
  startedBy             String    @db.VarChar(255)
  winnerId              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  finishedAt            DateTime?

  participants GameForcaParticipant[]

  @@map("game_forca")
}

model GameForcaParticipant {
  id           Int      @id @default(autoincrement())
  gameId       Int
  authorId     String   @db.VarChar(255)
  pointsEarned Int      @default(0)
  eliminated   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game GameForca @relation(fields: [gameId], references: [id])

  @@unique([gameId, authorId])
  @@map("game_forca_participants")
}

model Country {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  sigla       String   @unique @db.VarChar(255)
  description String?  @db.Text
  flag        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countries")
}

model GameScore {
  id            Int      @id @default(autoincrement())
  chatId        String   @db.VarChar(255)
  authorId      String   @db.VarChar(255)
  gameType      String   @db.VarChar(50)
  totalPoints   Int      @default(0)
  wins          Int      @default(0)
  matchesPlayed Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([chatId, authorId, gameType])
  @@map("game_scores")
}
