DATABASE_URL="mysql://root:123root4@localhost:3306/boot_whats"
PM2_BIN="/home/lang/.nvm/versions/node/v22.18.0/bin/pm2"

# Opcional: APP_ENV=development ativa logs extras. Se DEV_GROUP_ID estiver definido, em dev só esse grupo é processado.
APP_ENV=development
# ID do grupo (ex.: 123456789-9876543210@g.us). Com APP_ENV=development, apenas este grupo recebe comandos/análises.
# DEV_GROUP_ID=

# Pasta para salvar evidências de mídia removida pela IA
NSFW_EVIDENCE_DIR="./storage/deleted-media"

GEMINI_API_KEY=seu_token_aqui
GEMINI_MODEL=gemini-1.5-flash

# Chave da API do TheMovieDB (https://www.themoviedb.org/settings/api) para o comando /filme
THEMOVIEDB_API=seu_token_aqui

# Token da API RestCountries (https://api.restcountries.com) para o import de países (tools/import_countries.js)
RESTCOUNTRIES_API_KEY=seu_token_aqui

MAX_COMMANDS_PER_MINUTE=3
LLAMA_ENABLED = true
LLAMA_ENDPOINT = 'http://localhost:11434/api/generate'

# API HTTP para receber JSON e disparar mensagem no grupo
HTTP_INGEST_PORT=5000
HTTP_INGEST_KEY=sua_chave_secreta
HTTP_INGEST_GROUP_ID=123456789-9876543210@g.us

# --- Análise de imagens (processo bootwhats-analyzer) ---
# queue (padrão): o bot só enfileira e o worker analisa em outro processo.
# inline: analisa dentro do bot, como antes da fila. Use só como escape.
IMAGE_ANALYSIS_MODE=queue
# Onde o bot grava a mídia baixada até o worker consumir
MEDIA_SPOOL_DIR="./storage/spool"
# Bot: de quanto em quanto tempo procura vereditos prontos para aplicar
VERDICT_POLL_MS=2000
VERDICT_BATCH_SIZE=20
# Worker: pausa quando a fila está vazia
WORKER_IDLE_MS=1000
# Job preso em "processing" por mais que isso volta para a fila
JOB_LOCK_TIMEOUT_MS=300000
JOB_MAX_ATTEMPTS=3
JOB_STALE_SWEEP_MS=60000
# Worker sai (e o PM2 sobe de volta) após N jobs, zerando memória nativa do TF
ANALYZER_MAX_JOBS_BEFORE_EXIT=500

# --- LAION (segunda opinião, processo Python persistente) ---
LAION_PYTHON="./.venv/bin/python"
LAION_SCRIPT="tools/laion_score.py"
LAION_THRESHOLD=0.5
LAION_REQUEST_TIMEOUT_MS=120000
LAION_START_TIMEOUT_MS=300000
# Desliga o Python após esse tempo sem uso e devolve a RAM (0 = nunca desliga)
LAION_IDLE_SHUTDOWN_MS=1800000

# Tempo máximo esperando o client.destroy() antes de matar o Chromium à força
CLIENT_DESTROY_TIMEOUT_MS=30000

# Par backbone CLIP + cabeça de classificação do LAION:
#   b32        - ViT-B/32 com QuickGELU (padrão, correto)
#   l14        - ViT-L/14, o modelo que o README do LAION trata como principal
#   b32-legacy - ViT-B/32 SEM QuickGELU; reproduz o bug antigo, só para comparação
# Trocar de variante muda a escala dos scores: recalibre LAION_THRESHOLD com
# `node tools/nsfw_eval.js` antes de confiar na moderação.
LAION_VARIANT=b32
