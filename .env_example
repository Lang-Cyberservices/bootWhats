DATABASE_URL="mysql://root:123root4@localhost:3306/boot_whats"
PM2_BIN="/home/lang/.nvm/versions/node/v22.18.0/bin/pm2"

# Opcional: APP_ENV=development ativa logs extras. Se DEV_GROUP_ID estiver definido, em dev só esse grupo é processado.
APP_ENV=development
# ID do grupo (ex.: 123456789-9876543210@g.us). Com APP_ENV=development, apenas este grupo recebe comandos/análises.
# DEV_GROUP_ID=

# Pasta para salvar evidências de mídia removida pela IA
NSFW_EVIDENCE_DIR="./storage/deleted-media"

GEMINI_API_KEY=seu_token_aqui
GEMINI_MODEL=gemini-1.5-flash

MAX_COMMANDS_PER_MINUTE=3
LLAMA_ENABLED=true
LLAMA_ENDPOINT=http://localhost:11434/api/generate

# Número do bot com DDI/DDD, usado para menções e respostas do Llama.
BOOT_NUMBER=5511999999999

# API HTTP local para ingest e webhook da Evolution API.
HTTP_INGEST_PORT=5000
HTTP_INGEST_KEY=sua_chave_secreta
HTTP_INGEST_GROUP_ID=123456789-9876543210@g.us

# Evolution API
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_GLOBAL_API_KEY=bootwhats-dev-key
EVOLUTION_INSTANCE_NAME=bootwhats-dev
# Se deixar vazio, o bot tenta usar o token retornado pelo fetchInstances.
EVOLUTION_INSTANCE_TOKEN=
EVOLUTION_INSTANCE_INTEGRATION=WHATSAPP-BAILEYS
# Em dev com Docker, host.docker.internal aponta para sua máquina.
EVOLUTION_WEBHOOK_URL=http://127.0.0.1:5000/evolution/webhook
EVOLUTION_WEBHOOK_SECRET=troque_essa_chave
EVOLUTION_STATE_POLL_MS=15000
